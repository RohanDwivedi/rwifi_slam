<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wifi_rtt_interface</name>
  <version>0.13.0</version>
  <description>Publishes Wi-Fi RTT range observations from a simulation backend (Isaac Sim) or, in future, Android devices.</description>
  <maintainer email="myemail.rohan@gmail.com">Rohan Dwivedi</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/RohanDwivedi/rwifi_slam</url>
  <url type="bugtracker">https://github.com/RohanDwivedi/rwifi_slam/issues</url>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>wifi_rtt_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
