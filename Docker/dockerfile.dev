# Development image: ROS 2 Jazzy desktop plus the project's dependencies.
# The source tree is mounted at /ros2_ws/src at runtime (see compose.yaml) and
# built by entrypoint.sh. Isaac Sim is built separately and mounted as a volume.

FROM osrf/ros:jazzy-desktop AS dev

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python-is-python3 \
    python3-pip \
    ros-jazzy-rmw-zenoh-cpp \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws

# ROS dependencies, resolved from the package manifests only so this layer is cached
# until a package.xml changes.
COPY src/rwifi_slam_ros2/package.xml /tmp/deps/rwifi_slam_ros2/package.xml
COPY src/wifi_rtt_interface/package.xml /tmp/deps/wifi_rtt_interface/package.xml
COPY src/wifi_rtt_msgs/package.xml /tmp/deps/wifi_rtt_msgs/package.xml
RUN apt-get update \
  && rosdep update \
  && rosdep install --from-paths /tmp/deps --ignore-src -y \
  && rm -rf /var/lib/apt/lists/* /tmp/deps

# Python dependencies that have no rosdep key (installed after rosdep so numpy comes from apt).
COPY src/rwifi_slam_ros2/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt \
  && rm /tmp/requirements.txt

# Lint configuration at the workspace root so editors in the dev container pick it up.
COPY Docker/pyproject.toml Docker/.flake8 Docker/.yamllint /ros2_ws/

COPY Docker/entrypoint.sh /ros2_ws/entrypoint.sh
COPY scripts/build-isaac-sim-local.sh /ros2_ws/scripts/build-isaac-sim-local.sh
RUN chmod +x /ros2_ws/entrypoint.sh /ros2_ws/scripts/build-isaac-sim-local.sh \
  && chown 1000:1000 /ros2_ws

ENTRYPOINT ["/bin/bash", "/ros2_ws/entrypoint.sh"]
CMD ["bash"]
