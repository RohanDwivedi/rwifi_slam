
FROM nvcr.io/nvidia/base/ubuntu:noble-20250619

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=all

# Disable hardware-specific library optimizations for wider compatibility
RUN touch /etc/ld.so.nohwcap

# ROS 2 Jazzy repo + runtime deps Isaac needs (Xvfb + GL/EGL/X11 libs)
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      libatomic1 \
      ca-certificates \
      gnupg \
      software-properties-common \
      xvfb \
      libgl1 \
      libegl1 \
      libglib2.0-0 \
      libsm6 \
      libxext6 \
      libxrender1 \
      libgomp1 \
      libxrandr2 \
      libxinerama1 \
      libxcursor1 \
      libxi6 \
      libxfixes3 \
      libfontconfig1 \
      libfreetype6 \
      libglu1-mesa \
      libglx0 \
      libxt6 \
      libnghttp2-14 \
      python3-yaml \
      iproute2 \
      python-is-python3 \
      sudo \
      unzip \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
         | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
         http://packages.ros.org/ros2/ubuntu noble main" \
         > /etc/apt/sources.list.d/ros2.list \
    && curl -L https://download.eclipse.org/zenoh/debian-repo/zenoh-public-key \
         | gpg --dearmor --yes --output /etc/apt/keyrings/zenoh-public-key.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/zenoh-public-key.gpg] https://download.eclipse.org/zenoh/debian-repo/ /" \
         > /etc/apt/sources.list.d/zenoh.list \
    && apt-get update && apt-get install -y --no-install-recommends \
         ros-jazzy-ros-base \
         ros-jazzy-rclpy \
         ros-jazzy-rmw-zenoh-cpp \
    && apt-get -y autoremove \
    && apt-get clean autoclean \
    && rm -rf /var/lib/apt/lists/*

# Install Vulkan/EGL runtime configuration files (for headless GPU rendering)
RUN mkdir -p /usr/share/glvnd/egl_vendor.d /etc/vulkan/icd.d /etc/vulkan/implicit_layer.d

# NVIDIA EGL vendor configuration
RUN cat > /usr/share/glvnd/egl_vendor.d/10_nvidia.json <<'EOF'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "libEGL_nvidia.so.0"
    }
}
EOF

# Mesa EGL vendor configuration
RUN cat > /usr/share/glvnd/egl_vendor.d/50_mesa.json <<'EOF'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "libEGL_mesa.so.0"
    }
}
EOF

# NVIDIA Vulkan ICD configuration
RUN cat > /etc/vulkan/icd.d/nvidia_icd.json <<'EOF'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "libGLX_nvidia.so.0",
        "api_version" : "1.3.194"
    }
}
EOF

# NVIDIA Optimus Vulkan layer configuration
RUN cat > /etc/vulkan/implicit_layer.d/nvidia_layers.json <<'EOF'
{
    "file_format_version" : "1.0.0",
    "layer": {
        "name": "VK_LAYER_NV_optimus",
        "type": "INSTANCE",
        "library_path": "libGLX_nvidia.so.0",
        "api_version" : "1.3.194",
        "implementation_version" : "1",
        "description" : "NVIDIA Optimus layer",
        "functions": {
            "vkGetInstanceProcAddr": "vk_optimusGetInstanceProcAddr",
            "vkGetDeviceProcAddr": "vk_optimusGetDeviceProcAddr"
        },
        "enable_environment": {
            "__NV_PRIME_RENDER_OFFLOAD": "1"
        },
        "disable_environment": {
            "DISABLE_LAYER_NV_OPTIMUS_1": ""
        }
    }
}
EOF

USER root

COPY entrypoint-isaac-sim.sh /entrypoint-isaac-sim.sh
RUN chmod +x /entrypoint-isaac-sim.sh

RUN useradd -ms /bin/bash -l --uid 1234 isaac-sim -d /isaac-sim
RUN chown -R isaac-sim /tmp
USER isaac-sim

EXPOSE 47998/udp \
       49100/tcp

ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=all
ENV OMNI_SERVER=https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1
ENV MIN_DRIVER_VERSION=570.169
ENV VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json

WORKDIR /home/dev/dev/Docker/isaac-sim-6.0/IsaacSim/_build/linux-x86_64/release
