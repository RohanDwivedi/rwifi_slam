# Release image: ROS 2 Jazzy desktop with the rwifi_slam workspace built in.
# Published to ghcr.io/rohandwivedi/rwifi_slam by .github/workflows/release.yml.
# Isaac Sim is not included; mount it at runtime if you need the simulator.

FROM osrf/ros:jazzy-desktop AS release

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python-is-python3 \
    python3-pip \
    ros-jazzy-rmw-zenoh-cpp \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws

COPY --chown=1000:1000 src/ /ros2_ws/src/

RUN apt-get update \
  && rosdep update \
  && rosdep install --from-paths src --ignore-src -y \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages --no-cache-dir -r src/rwifi_slam_ros2/requirements.txt

RUN . /opt/ros/jazzy/setup.sh \
  && colcon build --event-handlers console_cohesion+ \
  && rm -rf build log \
  && chown -R 1000:1000 /ros2_ws

COPY Docker/entrypoint.sh /ros2_ws/entrypoint.sh
RUN chmod +x /ros2_ws/entrypoint.sh

ENTRYPOINT ["/bin/bash", "/ros2_ws/entrypoint.sh"]
CMD ["bash"]
