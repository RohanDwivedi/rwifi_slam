# Build the release image
# we dont mount volumes for the source code
# we copy the ws and build it inside the image
# Isaac sim is not packaged in this image
# intended for production release only

FROM osrf/ros:jazzy-desktop AS release

ARG DEV=true

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python-is-python3 \
    python3-pip \
    ros-jazzy-rmw-zenoh-cpp \
  && rm -rf /var/lib/apt/lists/*

# Copy entire src directory to ros2_ws/src
# .dockerignore excludes isaac-sim-6.0, which will be mounted separately
COPY --chown=1000:1000 src/ /ros2_ws/src/

WORKDIR /ros2_ws

COPY Docker/entrypoint.sh /entrypoint.sh
COPY Docker/requirements-dev.txt /requirements-dev.txt
COPY Docker/pyproject.toml /pyproject.toml
COPY Docker/.yamllint /.yamllint

RUN mkdir -p /scripts
COPY scripts/build-isaac-sim-local.sh /scripts/build-isaac-sim-local.sh

RUN chmod +x /entrypoint.sh \
  && chmod +x /scripts/build-isaac-sim-local.sh \
  && chown 1000:1000 /ros2_ws

RUN /scripts/build-isaac-sim-local.sh --quiet

RUN python3 -m pip install --break-system-packages -r /ros2_ws/requirements-dev.txt

ENTRYPOINT ["/bin/bash", "/ros2_ws/entrypoint.sh"]
CMD ["bash"]







